{
  "name": "mail-queue-api",
  "version": "1.0.0",
  "description": "Layered monolith that queues emails in PostgreSQL and delivers them through Resend with a background worker.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:local": "node scripts/local-db.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "resend": "^6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "supertest": "^7.1.0"
  },
  "license": "MIT"
}
