# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---
# Either set DATABASE_URL (takes precedence)...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mail_queue
# ...or the individual PG* variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=mail_queue
# Set to true for managed databases that require TLS (Render, Neon, Supabase...)
PGSSL=false
PG_POOL_MAX=10

# --- Resend ---
# Get a key at https://resend.com/api-keys. Never commit the real value.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Use onboarding@resend.dev until you verify your own domain.
EMAIL_FROM="Mail Queue <onboarding@resend.dev>"

# --- Background worker ---
# Run the worker inside the web process (monolith). Set to false if you run `npm run worker` separately.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10
# 1 initial attempt + 3 retries
EMAIL_MAX_ATTEMPTS=4
# Retry delay = base * 2^(attempt-1): 5s, 10s, 20s...
EMAIL_RETRY_BASE_DELAY_MS=5000
# A claimed job is re-queued if its worker dies and the lock expires
EMAIL_LOCK_TIMEOUT_MS=60000
